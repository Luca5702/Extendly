<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_xuan_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_seal_text"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_widget_seal_badge"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="#F6F2E9"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_quick_relief_title"
            android:textColor="#242C29"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_quick_relief_subtitle"
            android:textColor="#5B6661"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_start_cta"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_widget_cta_pill"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_quick_relief_cta"
        android:textColor="#F6F2E9"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
